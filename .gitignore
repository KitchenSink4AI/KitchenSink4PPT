# Environment / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Backups created by the server (slot folders)
.ks4p-backups/

# Local test corpus: real-world decks you drop in tests/corpus/ to run the
# full suite. Without them the suite generates synthetic stand-ins.
tests/corpus/*.pptx
tests/corpus/*.potx

# Test-built artifacts (acceptance decks, render PNGs); regenerated by the suite
tests/artifacts/*

# Validator state flag (written when validation is skipped because the
# user's PowerPoint was open)
tests/.ppt_validator_skipped

# packed bundles ship as release assets, not commits
bundle/*.mcpb

# CI needs this one synthetic 2KB test asset (PowerPoint-generated blank video)
!tests/artifacts/tiny_video.mp4

# Local-only files
internal/
*.local.*
